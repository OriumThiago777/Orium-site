{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node",
            "args": [".claude/hooks/post-commit-review.js"],
            "statusMessage": "Checando necessidade de code-review..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/check-visual-file.js"],
            "statusMessage": "Verificando padrão visual CLAUDE.md..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Read|Grep|Glob|Edit|Write",
        "hooks": [
          { "type": "command", "command": "node ./scripts/guard-project-scope.js" }
        ]
      }
    ]
  }
}
